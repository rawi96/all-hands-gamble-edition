{
  "name": "all-hands-casino",
  "version": "1.0.0",
  "description": "A hybrid all-hands casino game with virtual coins, Next.js and PostgreSQL",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.64.0",
    "motion": "^14.8.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
