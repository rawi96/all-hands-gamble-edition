# Local: docker compose up -d. Vercel: use your provider's POOLED PostgreSQL URL.
DATABASE_URL=postgresql://casino:casino@localhost:5432/casino
# Use a unique password (minimum 12 characters), and a separate random secret.
HOST_PASSWORD=replace-with-a-long-password
AUTH_SECRET=replace-with-at-least-32-random-characters
# Direct connection recommended for running migrations outside Vercel.
# MIGRATION_DATABASE_URL=postgresql://...
